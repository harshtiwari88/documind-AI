# Copy to .env (never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
MAX_PAGES=500
MAX_CONCURRENT_JOBS=4
RATE_LIMIT_PER_MIN=60
AUTH_REQUIRED=true      # false only for local testing
JWT_SECRET=             # optional; if empty a random one is generated in backend/.jwt_secret
DB_PATH=documind.db
AI_DAILY_LIMIT=100
WHISPER_MODEL=small          # tiny/base/small/medium; bigger = more accurate for Indian languages, slower
FRONTEND_URL=http://localhost:5173
# Password-reset email (optional; without these /auth/forgot returns 501)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated emails allowed to view private admin analytics
ADMIN_EMAILS=
# Required to create the account for an address listed in ADMIN_EMAILS (sign-up does not verify email ownership).
# Use a long random value, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_SETUP_KEY=
