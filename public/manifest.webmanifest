{
  "id": "/",
  "name": "Harsh AI – Intelligent Document Companion",
  "short_name": "Harsh AI",
  "description": "Your Intelligent Document & AI Companion. Edit PDFs, issue voice commands, and generate visual mind maps.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b132b",
  "theme_color": "#0b132b",
  "categories": ["productivity", "utilities", "education"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "PDF Editor Studio",
      "short_name": "Editor",
      "description": "Open Desktop PDF Editor with visual annotations",
      "url": "/editor",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Harsh AI Assistant",
      "short_name": "Assistant",
      "description": "Ask Harsh AI document Q&A and generate study notes",
      "url": "/assistant",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Voice Studio",
      "short_name": "Voice",
      "description": "Voice-controlled document editing in Hinglish and English",
      "url": "/voice",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Documents Vault",
      "short_name": "Documents",
      "description": "Manage saved PDF documents and version history",
      "url": "/documents",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
}
